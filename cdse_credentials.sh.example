#!/usr/bin/env bash
# Copy to cdse_credentials.sh (gitignored) and fill in. Two separate free accounts:

# 1. Copernicus Data Space (https://dataspace.copernicus.eu): Sentinel-3 downloads.
export CDSE_USERNAME='your_email@example.com'
export CDSE_PASSWORD='your_password'

# 2. Copernicus Marine (https://marine.copernicus.eu): surface currents for back-tracking.
export COPERNICUSMARINE_SERVICE_USERNAME='your_marine_username'
export COPERNICUSMARINE_SERVICE_PASSWORD='your_marine_password'

# Last resort if the node's Python certificate store cannot verify the Data Space servers:
# export CDSE_SSL_NO_VERIFY=1
