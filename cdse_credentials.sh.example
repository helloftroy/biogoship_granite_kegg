#!/usr/bin/env bash
# Copy to cdse_credentials.sh (gitignored) and fill in your Copernicus Data Space
# account (free: https://dataspace.copernicus.eu). Downloads need it; searches do not.

export CDSE_USERNAME='your_email@example.com'
export CDSE_PASSWORD='your_password'

# Last resort if the node's Python certificate store cannot verify CDSE:
# export CDSE_SSL_NO_VERIFY=1
